# URL pública do Keycloak vista pelo navegador.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=anysale-realm
VITE_KEYCLOAK_CLIENT_ID=anysale-console

# Em desenvolvimento, deixe vazio: o Vite encaminha /api para o lead-service local
# e evita CORS. Em produção, informe a URL pública do gateway/API.
# VITE_LEAD_SERVICE_URL=/api

# Em desenvolvimento, o Vite encaminha este caminho ao catalog-service local.
# VITE_CATALOG_SERVICE_URL=/catalog-api
